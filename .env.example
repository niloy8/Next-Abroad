# NextAbroad AI - Production Environment Variables Example

# Backend Database
# PostgreSQL production connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nextabroad
# SQLite for local instant zero-setup dev:
# DATABASE_URL=sqlite+aiosqlite:///./nextabroad.db

# Security & Authentication
JWT_SECRET=production-secret-study-path-abroad-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set AI_PROVIDER to "gemini", "openai", or "mock"
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search Provider Configuration
# Set SEARCH_PROVIDER to "tavily", "serpapi", "brave", or "mock"
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
