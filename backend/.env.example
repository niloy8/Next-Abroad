# Database Configuration
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nextabroad
# For zero-config local development, SQLite async is supported automatically:
DATABASE_URL=sqlite+aiosqlite:///./nextabroad.db

# JWT & Authentication Secret
JWT_SECRET=super-secret-production-grade-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ("gemini", "openai", or "mock")
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search Provider Configuration ("tavily", "serpapi", "brave", or "mock")
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
